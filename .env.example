# =========================================
# AI Document-to-Mindmap – Biến môi trường
# Sao chép file này thành .env và điền giá trị thực
# =========================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docmind

# --- Backend ---
# URL kết nối DB (asyncpg driver cho SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/docmind

# Giới hạn dung lượng file upload (MB)
MAX_UPLOAD_MB=20

# Đường dẫn lưu file trong container (mount từ ./storage/uploads)
STORAGE_PATH=/storage/uploads

# Origins được phép gọi API (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:80","http://localhost"]

# --- Frontend ---
# URL backend API (gọi từ trình duyệt của người dùng)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Ollama AI ---
# Host Ollama (trên máy local: host.docker.internal để Docker gọi sang host)
OLLAMA_HOST=http://host.docker.internal:11434
# Tên model đã tạo trong Ollama
OLLAMA_MODEL=mindmap-model
# Timeout giây cho mỗi lần gọi AI
OLLAMA_TIMEOUT=120
