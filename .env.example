# =========================================
# AI Document-to-Mindmap – Biến môi trường
# Sao chép file này thành .env và điền giá trị thực
# =========================================

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=docmind

# --- Backend ---
# URL kết nối DB (asyncpg driver cho SQLAlchemy async)
DATABASE_URL=postgresql+asyncpg://postgres:changeme@postgres:5432/docmind

# Giới hạn dung lượng file upload (MB)
MAX_UPLOAD_MB=20

# Đường dẫn lưu file trong container (mount từ ./storage/uploads)
STORAGE_PATH=/storage/uploads

# Origins được phép gọi API (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:80","http://localhost"]

# Cookie HTTPOnly cho phiên đăng nhập. Bật true khi triển khai qua HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=7

# --- Frontend ---
# URL backend API (gọi từ trình duyệt của người dùng)
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Ollama AI ---
# Host Ollama (trên máy local: host.docker.internal để Docker gọi sang host)
OLLAMA_HOST=http://host.docker.internal:11434
# Tên model đã tạo trong Ollama
OLLAMA_MODEL=mindmap-model
# Timeout giây cho mỗi lần gọi AI
OLLAMA_TIMEOUT=120

# --- Pipeline AI hai bước ---
# Mỗi bước chọn một provider: ollama, gemini hoặc openai.
# Mặc định dùng Ollama local để nội dung không rời khỏi máy chủ của bạn.
AI_STEP1_PROVIDER=ollama
AI_STEP2_PROVIDER=ollama
AI_STEP1_MODEL=
AI_STEP2_MODEL=
AI_TIMEOUT=180
# Chỉ điền khóa nếu chọn provider cloud cho một trong hai bước.
GEMINI_API_KEY=
OPENAI_API_KEY=
